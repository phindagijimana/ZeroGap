# Railway serves the site through Caddy on the injected $PORT.
:{$PORT:80} {
	root * /srv
	file_server
	encode gzip

	# SPA-style routing: client toggles "pages" via JS, so unknown
	# paths fall back to index.html rather than 404.
	try_files {path} /index.html

	# Security headers (defense-in-depth for a static site).
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Long cache for fingerprintable static assets; HTML stays revalidated.
	@assets path /css/* /js/* /favicon.svg
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}
